{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Debug"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "event-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      },


      "venue-map-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/venue-maps/{**catch-all}"
        }
      },

      "venue-map-ai-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/venue-map-ai/{**catch-all}"
        }
      },

      "category-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },

      "location-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/locations/{**catch-all}"
        }
      },

      "schedule-route": {
        "ClusterId": "event-cluster",
        "Match": {
          "Path": "/api/schedules/{**catch-all}"
        }
      },

      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/seats/{**catch-all}"
        }
      },
      "booking-hub-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/hubs/bookingHub/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "Connection",
            "Set": "Upgrade"
          }
        ]
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://authservice:8080/"
          }
        }
      },

      "event-cluster": {
        "Destinations": {
          "event-destination": {
            "Address": "http://eventservice:8080/"
          }
        }
      },

      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://bookingservice:8080/"
          }
        }
      }
    }
  }
}