@page "/admin/events"
@rendermode InteractiveServer

@using EventHub.Web.Models.Category
@using EventHub.Web.Models.Event
@using EventHub.Web.Models.Location
@using EventHub.Web.Services

@inject EventApiService EventApiService
@inject NavigationManager NavigationManager

<PageTitle>Quản lý sự kiện - EventHub</PageTitle>

<div class="admin-events-page">

    <div class="page-header">
        <div>
            <span class="page-label">ADMIN</span>
            <h1>Quản lý sự kiện</h1>
            <p>Thêm, chỉnh sửa và quản lý các sự kiện trên EventHub.</p>
        </div>

        <button class="add-btn" @onclick="OpenCreateForm">
            + Thêm sự kiện
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="success-message">
            ✓ @message
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            ⚠ @errorMessage
        </div>
    }

    @if (showForm)
    {
        <div class="form-card">

            <div class="form-header">
                <div>
                    <h2>@(editingId.HasValue ? "Chỉnh sửa sự kiện" : "Thêm sự kiện")</h2>
                    <p>Nhập thông tin sự kiện bên dưới.</p>
                </div>

                <button class="close-btn" @onclick="CloseForm">
                    ×
                </button>
            </div>

            <div class="form-grid">

                <div class="form-group full">
                    <label>Tên sự kiện *</label>
                    <input @bind="form.Name"
                           placeholder="Ví dụ: Đêm nhạc EventHub 2026" />
                </div>

                <div class="form-group full">
                    <label>Mô tả</label>
                    <textarea @bind="form.Description"
                              rows="4"
                              placeholder="Mô tả nội dung sự kiện..."></textarea>
                </div>

                <div class="form-group full">
                    <label>Image URL</label>
                    <input @bind="form.ImageUrl"
                           placeholder="https://..." />
                </div>

                <div class="form-group full">
                    <label>Sơ đồ sân khấu / khu vực</label>
                    <input @bind="form.VenueMapImageUrl"
                           placeholder="ảnh sơ đồ sân khấu/khu vực" />

                    @if (!string.IsNullOrWhiteSpace(form.VenueMapImageUrl))
                    {
                        <div class="venue-map-preview">
                            <img src="@form.VenueMapImageUrl"
                                 alt="Sơ đồ sân khấu / khu vực" />
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label>Danh mục *</label>

                    <select class="form-control" @bind="categoryText">
                        <option value="Âm nhạc">Âm nhạc</option>
                        <option value="Workshop">Workshop</option>
                        <option value="Giải trí">Giải trí</option>
                        <option value="Thể thao">Thể thao</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Địa điểm *</label>

                    <input type="text"
                           class="form-control"
                           list="location-list"
                           @bind="locationText"
                           placeholder="Nhập địa điểm..." />

                    <datalist id="location-list">
                        @foreach (var location in locations)
                        {
                            <option value="@location.Name"></option>
                        }
                    </datalist>
                </div>

                <div class="form-group">
                    <label>Địa chỉ *</label>

                    <input type="text"
                            class="form-control"
                            @bind="locationAddress"
                            placeholder="Ví dụ: 01 Nguyễn Tất Thành" />
                </div>

                <div class="form-group">
                    <label>Thành phố</label>

                    <input type="text"
                            class="form-control"
                            @bind="locationCity"
                            placeholder="Ví dụ: Quy Nhơn" />
                </div>

                <div class="form-group">
                    <label>Sức chứa *</label>

                    <input type="number"
                            class="form-control"
                            @bind="locationCapacity"
                            min="1"
                            placeholder="Ví dụ: 1000" />
                </div>

                <div class="form-group">
                    <label>Thời gian bắt đầu <span>*</span></label>

                    <div class="custom-datetime">

                        <button type="button"
                                class="datetime-trigger @(startPickerOpen ? "active" : "")"
                                @onclick="ToggleStartPicker">

                            <span class="datetime-trigger-icon">📅</span>

                            <span class="datetime-trigger-content">

                                <span class="datetime-trigger-value">
                                    @FormatDateTime(startDateValue)
                                </span>
                            </span>

                            <span class="datetime-trigger-arrow">
                                @(startPickerOpen ? "⌃" : "⌄")
                            </span>

                        </button>

                        @if (startPickerOpen)
                        {
                            <div class="datetime-picker">

                                <div class="picker-header">
                                    <button type="button"
                                            @onclick="PreviousStartMonth">
                                        ‹
                                    </button>

                                    <strong>
                                        @GetMonthName(startDateValue)
                                    </strong>

                                    <button type="button"
                                            @onclick="NextStartMonth">
                                        ›
                                    </button>
                                </div>

                                <div class="calendar-weekdays">
                                    <span>T2</span>
                                    <span>T3</span>
                                    <span>T4</span>
                                    <span>T5</span>
                                    <span>T6</span>
                                    <span>T7</span>
                                    <span>CN</span>
                                </div>

                                <div class="calendar-grid">
                                    @foreach (var day in GetCalendarDays(startDateValue))
                                    {
                                        <button type="button"
                                                class="calendar-day @(day.Month != startDateValue.Month ? "muted" : "") @(day.Date == startDateValue.Date ? "selected" : "")"
                                                @onclick="() => SelectStartDate(day)">
                                            @day.Day
                                        </button>
                                    }
                                </div>

                                <div class="picker-divider"></div>

                                <div class="time-section">
                                    <span class="time-title">🕐 Thời gian</span>

                                    <div class="time-controls">

                                        <select @bind="startHour">
                                            @for (var hour = 0; hour < 24; hour++)
                                            {
                                                <option value="@hour">
                                                    @hour.ToString("00")
                                                </option>
                                            }
                                        </select>

                                        <span>:</span>

                                        <select @bind="startMinute">
                                            @for (var minute = 0; minute < 60; minute += 5)
                                            {
                                                <option value="@minute">
                                                    @minute.ToString("00")
                                                </option>
                                            }
                                        </select>

                                    </div>
                                </div>

                                <div class="picker-footer">
                                    <button type="button"
                                            class="picker-today"
                                            @onclick="SetStartToday">
                                        Hôm nay
                                    </button>

                                    <button type="button"
                                            class="picker-confirm"
                                            @onclick="ConfirmStartPicker">
                                        Xác nhận
                                    </button>
                                </div>

                            </div>
                        }

                    </div>
                </div>


                <div class="form-group">
                    <label>Thời gian kết thúc <span>*</span></label>

                    <div class="custom-datetime">

                        <button type="button"
                                class="datetime-trigger @(endPickerOpen ? "active" : "")"
                                @onclick="ToggleEndPicker">

                            <span class="datetime-trigger-icon">📅</span>

                            <span class="datetime-trigger-content">

                                <span class="datetime-trigger-value">
                                    @FormatDateTime(endDateValue)
                                </span>
                            </span>

                            <span class="datetime-trigger-arrow">
                                @(endPickerOpen ? "⌃" : "⌄")
                            </span>

                        </button>

                        @if (endPickerOpen)
                        {
                            <div class="datetime-picker">

                                <div class="picker-header">
                                    <button type="button"
                                            @onclick="PreviousEndMonth">
                                        ‹
                                    </button>

                                    <strong>
                                        @GetMonthName(endDateValue)
                                    </strong>

                                    <button type="button"
                                            @onclick="NextEndMonth">
                                        ›
                                    </button>
                                </div>

                                <div class="calendar-weekdays">
                                    <span>T2</span>
                                    <span>T3</span>
                                    <span>T4</span>
                                    <span>T5</span>
                                    <span>T6</span>
                                    <span>T7</span>
                                    <span>CN</span>
                                </div>

                                <div class="calendar-grid">
                                    @foreach (var day in GetCalendarDays(endDateValue))
                                    {
                                        <button type="button"
                                                class="calendar-day @(day.Month != endDateValue.Month ? "muted" : "") @(day.Date == endDateValue.Date ? "selected" : "")"
                                                @onclick="() => SelectEndDate(day)">
                                            @day.Day
                                        </button>
                                    }
                                </div>

                                <div class="picker-divider"></div>

                                <div class="time-section">
                                    <span class="time-title">🕐 Thời gian</span>

                                    <div class="time-controls">

                                        <select @bind="endHour">
                                            @for (var hour = 0; hour < 24; hour++)
                                            {
                                                <option value="@hour">
                                                    @hour.ToString("00")
                                                </option>
                                            }
                                        </select>

                                        <span>:</span>

                                        <select @bind="endMinute">
                                            @for (var minute = 0; minute < 60; minute += 5)
                                            {
                                                <option value="@minute">
                                                    @minute.ToString("00")
                                                </option>
                                            }
                                        </select>

                                    </div>
                                </div>

                                <div class="picker-footer">
                                    <button type="button"
                                            class="picker-today"
                                            @onclick="SetEndToday">
                                        Hôm nay
                                    </button>

                                    <button type="button"
                                            class="picker-confirm"
                                            @onclick="ConfirmEndPicker">
                                        Xác nhận
                                    </button>
                                </div>

                            </div>
                        }

                    </div>
                </div>

                <div class="form-group">
                    <label>Trạng thái</label>

                    <select @bind="form.Status">
                        <option value="Draft">Draft</option>
                        <option value="Published">Published</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>

            </div>

            <div class="form-actions">

                <button class="cancel-btn"
                        @onclick="CloseForm">
                    Hủy
                </button>

                <button class="save-btn"
                        @onclick="SaveEventAsync"
                        disabled="@isSaving">

                    @(isSaving
                        ? "Đang lưu..."
                        : editingId.HasValue
                            ? "Lưu thay đổi"
                            : "Tạo sự kiện")
                </button>

            </div>

        </div>
    }

    <div class="events-table-card">

        <div class="table-header">
            <div>
                <h2>Danh sách sự kiện</h2>
                <span>@events.Count sự kiện</span>
            </div>

            <button class="refresh-btn"
                    @onclick="LoadDataAsync">
                ↻ Làm mới
            </button>
        </div>

        @if (isLoading)
        {
            <div class="loading">
                Đang tải dữ liệu...
            </div>
        }
        else if (events.Count == 0)
        {
            <div class="empty">
                <div>🎫</div>
                <h3>Chưa có sự kiện</h3>
                <p>Hãy tạo sự kiện đầu tiên.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Sự kiện</th>
                            <th>Danh mục</th>
                            <th>Địa điểm</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in events)
                        {
                            <tr>

                                <td>
                                    <div class="event-name">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <div class="mini-placeholder">
                                                🎫
                                            </div>
                                        }

                                        <div>
                                            <strong>@item.Name</strong>

                                            <span>
                                                @item.Description
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @item.CategoryName
                                </td>

                                <td>
                                    @item.LocationName
                                </td>

                                <td>
                                    @(item.StartDate
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                                </td>

                                <td>
                                    <span class="@GetStatusClass(item.Status)">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="actions">

                                        <button class="view-btn"
                                                @onclick="() => ViewEvent(item.Id)">
                                            Xem
                                        </button>

                                        <button class="edit-btn"
                                                @onclick="() => EditEventAsync(item.Id)">
                                            Sửa
                                        </button>

                                        <button class="delete-btn"
                                                @onclick="() => DeleteEventAsync(item.Id)">
                                            Xóa
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
    </div>

</div>

@code {

    private List<EventDto> events = new();
    private List<CategoryDto> categories = new();
    private List<LocationDto> locations = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool showForm;

    private Guid? editingId;

    private string? message;
    private string? errorMessage;

    private CreateEventRequest form = new();

    private string startDateText = "";
    private string endDateText = "";
    private string categoryText = string.Empty;

    private string locationText = string.Empty;
    private string locationAddress = string.Empty;
    private string locationCity = string.Empty;
    private int locationCapacity;

    private bool startPickerOpen;
    private bool endPickerOpen;

    private DateTime startDateValue = DateTime.Now;
    private DateTime endDateValue = DateTime.Now.AddHours(2);

    private int startHour;
    private int startMinute;

    private int endHour;
    private int endMinute;

    private static readonly string[] AllowedCategories =
        {
			"Âm nhạc",
			"Workshop",
            "Giải trí",
			"Thể thao"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var eventsTask = EventApiService.GetEventsAsync();
            var categoriesTask = EventApiService.GetCategoriesAsync();
            var locationsTask = EventApiService.GetLocationsAsync();

            await Task.WhenAll(
                eventsTask,
                categoriesTask,
                locationsTask);

            events = await eventsTask;
            categories = await categoriesTask;
            locations = await locationsTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Không thể tải dữ liệu quản lý sự kiện.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateForm()
    {
        editingId = null;

        form = new CreateEventRequest
        {
            Status = "Draft"
        };

        startDateText = "";
        endDateText = "";
        startDateValue = DateTime.Now;
        startHour = startDateValue.Hour;
        startMinute = startDateValue.Minute;
        endDateValue = DateTime.Now.AddHours(2);
        endHour = endDateValue.Hour;
        endMinute = endDateValue.Minute;
        startPickerOpen = false;
        endPickerOpen = false;

        categoryText = "";

        locationText = "";
        locationAddress = "";
        locationCity = "";
        locationCapacity = 0;

        message = null;
        errorMessage = null;

        showForm = true;
    }

    // dinh dang ngay gio
    private string FormatDateTime(DateTime value)
    {
        return value.ToString("dd/MM/yyyy . HH:mm");
    }

    //hien thi thang
    private string GetMonthName(DateTime date)
    {
        return date.ToString("MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"));
    }

    //lay danh sach ngay thang
    private List<DateTime> GetCalendarDays(DateTime currentDate)
    {
        var firstDayOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);

        // sunday =0 , monday =1
        //bắt đầu từ thứ 2
        var offset = ((int)firstDayOfMonth.DayOfWeek + 6) % 7;

        var calendarStart = firstDayOfMonth.AddDays(-offset);

        var days= new List<DateTime>();

        for (var i=0; i<42; i++)
        {
            days.Add(calendarStart.AddDays(i));
        }
        return days;
    }

    //sử lý picker
    private void ToggleStartPicker()
    {
        startPickerOpen = !startPickerOpen;
        endPickerOpen = false;

        if (startPickerOpen){
            SyncStartPickerValues();
        }
    }
    private void SyncStartPickerValues()
    {
        startHour = startDateValue.Hour;
        startMinute = startDateValue.Minute;
    }
    //chuyển tháng trước
    private void PreviousStartMonth()
    {
        startDateValue = startDateValue.AddMonths(-1);
    }
    //chuyển tháng sau
    private void NextStartMonth()
    {
        startDateValue = startDateValue.AddMonths(1);
    }
    //chọn ngày
    private void SelectStartDate(DateTime date)
    {
        startDateValue = new DateTime(
            date.Year,
            date.Month,
            date.Day,
            startHour,
            startMinute,
            0);
    }
    //đặt hôm nay
    private void SetStartToday()
    {
        var now = DateTime.Now;
        startDateValue = new DateTime(
            now.Year,
            now.Month,
            now.Day,
            startHour,
            startMinute,
            0);

        startHour = startDateValue.Hour;
        startMinute = startDateValue.Minute;
    }
    //xác nhận
    private void ConfirmStartPicker()
    {
        startDateValue = new DateTime(
            startDateValue.Year,
            startDateValue.Month,
            startDateValue.Day,
            startHour,
            startMinute,
            0);
        startDateText = startDateValue.ToString("yyyy-MM-ddTHH:mm");
        startPickerOpen = false;
    }
    //sử lý picker kết thúc
    private void ToggleEndPicker()
    {
        endPickerOpen = !endPickerOpen;
        startPickerOpen = false;
        if (endPickerOpen)
        {
            SyncEndPickerValues();
        }
    }
    private void SyncEndPickerValues()
    {
        endHour = endDateValue.Hour;
        endMinute = endDateValue.Minute;
    }
    private void PreviousEndMonth()
    {
        endDateValue = endDateValue.AddMonths(-1);
    }
    private void NextEndMonth()
    {
        endDateValue = endDateValue.AddMonths(1);
    }
    private void SelectEndDate(DateTime date)
    {
        endDateValue = new DateTime(
            date.Year,
            date.Month,
            date.Day,
            endHour,
            endMinute,
            0);
    }
    private void SetEndToday()
    {
        var now = DateTime.Now;
        endDateValue = new DateTime(
            now.Year,
            now.Month,
            now.Day,
            endHour,
            endMinute,
            0);
        endHour = endDateValue.Hour;
        endMinute = endDateValue.Minute;
    }
    private void ConfirmEndPicker()
    {
        endDateValue = new DateTime(
            endDateValue.Year,
            endDateValue.Month,
            endDateValue.Day,
            endHour,
            endMinute,
            0);
        endDateText = endDateValue.ToString("yyyy-MM-ddTHH:mm");
        endPickerOpen = false;
    }

    private async Task EditEventAsync(Guid id)
    {
        try
        {
            errorMessage = null;
            message = null;

            var item = await EventApiService.GetEventByIdAsync(id);

            if (item is null)
            {
                errorMessage = "Không tìm thấy sự kiện.";
                return;
            }

            editingId = id;

            form = new CreateEventRequest
            {
                Name = item.Name,
                Description = item.Description,
                ImageUrl = item.ImageUrl,
                VenueMapImageUrl = item.VenueMapImageUrl,
                Status = item.Status
            };

            categoryText = item.CategoryName ?? string.Empty;
            locationText = item.LocationName ?? string.Empty;

            var selectedLocation = locations.FirstOrDefault(x =>
                x.Id == item.LocationId);

            locationAddress =
                selectedLocation?.Address
                ?? item.LocationAddress
                ?? string.Empty;

            locationCity =
                selectedLocation?.City
                ?? item.City
                ?? string.Empty;

            locationCapacity =
                selectedLocation?.Capacity
                ?? 0;

            startDateText = item.StartDate
                .ToLocalTime()
                .ToString("yyyy-MM-ddTHH:mm");
            if(DateTime.TryParse(startDateText,out var parsedStart))
            {
                startDateValue = parsedStart;
                startHour = parsedStart.Hour;
                startMinute = parsedStart.Minute;

            }

            endDateText = item.EndDate
                .ToLocalTime()
                .ToString("yyyy-MM-ddTHH:mm");
            if(DateTime.TryParse(endDateText,out var parsedEnd))
            {
                endDateValue = parsedEnd;
                endHour = parsedEnd.Hour;
				endMinute = parsedEnd.Minute;
            }

            startPickerOpen = false;
			endPickerOpen = false;

            showForm = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Không thể tải thông tin sự kiện.";
        }
    }

    private void HandleLocationChanged(ChangeEventArgs e)
    {
        locationText = e.Value?.ToString() ?? string.Empty;

        var location = locations.FirstOrDefault(x =>
            string.Equals(
                x.Name?.Trim(),
                locationText.Trim(),
                StringComparison.OrdinalIgnoreCase));

        if (location is not null)
        {
            locationAddress = location.Address;
            locationCity = location.City ?? string.Empty;
            locationCapacity = location.Capacity;
        }
        else
        {
            locationAddress = string.Empty;
            locationCity = string.Empty;
            locationCapacity = 0;
        }
    }

    private async Task SaveEventAsync()
    {
        try
        {
            message = null;
            errorMessage = null;

            if (string.IsNullOrWhiteSpace(form.Name))
            {
                errorMessage = "Vui lòng nhập tên sự kiện.";
                return;
            }

            if (string.IsNullOrWhiteSpace(categoryText))
            {
                errorMessage = "Vui lòng chọn danh mục.";
                return;
            }

            if (string.IsNullOrWhiteSpace(locationText))
            {
               errorMessage = "Vui lòng nhập địa điểm.";
               return;
            }

            if (string.IsNullOrWhiteSpace(locationAddress))
            {
              errorMessage = "Vui lòng nhập địa chỉ.";
              return;
            }

            if (locationCapacity <= 0)
            {
              errorMessage = "Sức chứa phải lớn hơn 0.";
              return;
            }

            if (!DateTime.TryParse(
                    startDateText,
                    out var startDate))
            {
                errorMessage = "Thời gian bắt đầu không hợp lệ.";
                return;
            }

            if (!DateTime.TryParse(
                    endDateText,
                    out var endDate))
            {
                errorMessage = "Thời gian kết thúc không hợp lệ.";
                return;
            }

            if (endDate <= startDate)
            {
                errorMessage =
                    "Thời gian kết thúc phải sau thời gian bắt đầu.";
                return;
            }

            form.StartDate = startDate.ToUniversalTime();
            form.EndDate = endDate.ToUniversalTime();

            isSaving = true;

            if (editingId.HasValue)
            {
                var request = new UpdateEventRequest
                {
                    Name = form.Name,
                    Description = form.Description,
                    ImageUrl = form.ImageUrl,
                    VenueMapImageUrl = form.VenueMapImageUrl,
                    CategoryName = categoryText,
                    LocationName = locationText,
                    LocationAddress = locationAddress,
                    LocationCity = locationCity,
                    LocationCapacity = locationCapacity,
                    StartDate = form.StartDate,
                    EndDate = form.EndDate,
                    Status = form.Status
                };

                var success =
                    await EventApiService.UpdateEventAsync(
                        editingId.Value,
                        request);

                if (!success)
                {
                    errorMessage = "Không thể cập nhật sự kiện.";
                    return;
                }

                message = "Cập nhật sự kiện thành công.";
            }
            else
            {
                form.CategoryName = categoryText;
                form.LocationName = locationText;
                form.LocationAddress = locationAddress;
                form.LocationCity = locationCity;
                form.LocationCapacity = locationCapacity;
                var created =
                    await EventApiService.CreateEventAsync(form);

                if (created is null)
                {
                    errorMessage = "Không thể tạo sự kiện.";
                    return;
                }

                message = "Tạo sự kiện thành công.";
            }

            showForm = false;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Đã xảy ra lỗi khi lưu sự kiện.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteEventAsync(Guid id)
    {
        try
        {
            message = null;
            errorMessage = null;

            var success =
                await EventApiService.DeleteEventAsync(id);

            if (!success)
            {
                errorMessage = "Không thể xóa sự kiện.";
                return;
            }

            message = "Xóa sự kiện thành công.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Đã xảy ra lỗi khi xóa sự kiện.";
        }
    }

    private void ViewEvent(Guid id)
    {
        NavigationManager.NavigateTo($"/events/{id}");
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Published" => "status published",
            "Cancelled" => "status cancelled",
            "Completed" => "status completed",
            _ => "status draft"
        };
    }
}