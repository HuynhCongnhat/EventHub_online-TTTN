@page "/forgot-password"
@rendermode InteractiveServer
@using EventHub.Web.Services
@using EventHub.Web.Models.Auth

<PageTitle>Quên mật khẩu - EventHub</PageTitle>

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="logo">EventHub</div>

            <h1>Quên mật khẩu</h1>

            <p>Nhập email để đặt lại mật khẩu</p>
        </div>

        <EditForm Model="@forgotPasswordModel"
                  OnValidSubmit="@HandleForgotPassword"
                  FormName="ForgotPasswordForm">

            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">Email</label>

                <InputText id="email"
                           class="form-control"
                           @bind-Value="forgotPasswordModel.Email"
                           placeholder="Nhập email" />

                <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    @successMessage
                </div>
            }

            <button type="submit"
                    class="btn-forgot"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>Gửi yêu cầu</span>
                }

            </button>

        </EditForm>

        <div class="auth-links">

            <div>
                Nhớ mật khẩu?
                <a href="/login">Đăng nhập</a>
            </div>

            <div>
                Chưa có tài khoản?
                <a href="/register">Đăng ký</a>
            </div>

        </div>

    </div>
</div>

@code {

    [Inject]
    private AuthApiService AuthApiService { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private ForgotPasswordModel forgotPasswordModel = new();

    private bool isLoading;

    private string? errorMessage;

    private string? successMessage;

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var email = forgotPasswordModel.Email.Trim();

            if (string.IsNullOrWhiteSpace(email))
            {
                errorMessage = "Vui lòng nhập email.";
                return;
            }

            var request = new ForgotPasswordRequest
            {
                Email = email
            };

            var result =
                await AuthApiService.ForgotPasswordAsync(request);

            if (result.Success)
            {
                // Hiển thị thông báo thành công
                successMessage =
                    "Đã gửi mã xác nhận đến Email của bạn!";

                // Cho người dùng nhìn thấy thông báo
                await Task.Delay(1500);

                // Chuyển sang trang đổi mật khẩu
                Navigation.NavigateTo(
                    $"/reset-password?email={Uri.EscapeDataString(email)}");
            }
            else
            {
                // Email không tồn tại hoặc API trả về lỗi
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Đã xảy ra lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(
            ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = string.Empty;
    }
}