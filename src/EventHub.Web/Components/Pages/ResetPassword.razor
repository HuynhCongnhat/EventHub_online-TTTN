@page "/reset-password"
@rendermode InteractiveServer

@using EventHub.Web.Models.Auth
@using EventHub.Web.Services
@using Microsoft.AspNetCore.Components

@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>Đặt lại mật khẩu - EventHub</PageTitle>

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="logo">EventHub</div>

            <h1>Đặt lại mật khẩu</h1>

            <p>
                Nhập mã xác thực và mật khẩu mới của bạn
            </p>
        </div>

        <EditForm Model="@resetPasswordModel"
                  OnValidSubmit="@HandleResetPassword"
                  FormName="ResetPasswordForm">

            <DataAnnotationsValidator />

            @* <div class="form-group">
                <label for="email">Email</label>

                <InputText id="email"
                           class="form-control"
                           @bind-Value="resetPasswordModel.Email"
                           placeholder="Nhập email" />

                <ValidationMessage For="@(() => resetPasswordModel.Email)" />
            </div> *@

            <div class="reset-email-display">
                <span class="reset-email-label">Email: </span>

                <strong>@Email</strong>
            </div>

            <div class="form-group">
                <label for="token">Mã xác thực</label>

                <InputText id="token"
                           class="form-control"
                           @bind-Value="resetPasswordModel.Token"
                           placeholder="Nhập mã xác thực" />

                <ValidationMessage For="@(() => resetPasswordModel.Token)" />

                <small class="form-help">
                    Nhập mã reset password được cung cấp từ hệ thống.
                </small>
            </div>

            <div class="form-group">
                <label for="new-password">Mật khẩu mới</label>

                <InputText id="new-password"
                           type="password"
                           class="form-control"
                           @bind-Value="resetPasswordModel.NewPassword"
                           placeholder="Nhập mật khẩu mới" />

                <ValidationMessage For="@(() => resetPasswordModel.NewPassword)" />
            </div>

            <div class="form-group">
                <label for="confirm-password">Xác nhận mật khẩu mới</label>

                <InputText id="confirm-password"
                           type="password"
                           class="form-control"
                           @bind-Value="resetPasswordModel.ConfirmPassword"
                           placeholder="Nhập lại mật khẩu mới" />

                <ValidationMessage For="@(() => resetPasswordModel.ConfirmPassword)" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    @successMessage
                </div>
            }

            <button type="submit"
                    class="btn-reset"
                    disabled="@isLoading">

                @if (isLoading)
                {
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>Đặt lại mật khẩu</span>
                }

            </button>

        </EditForm>

    </div>
</div>

@code {

    private ResetPasswordModel resetPasswordModel = new();

    private bool isLoading;

    private string? errorMessage;

    private string? successMessage;

    [Parameter]
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            Email = Uri.UnescapeDataString(Email);

            resetPasswordModel.Email = Email;
        }
    }

    private async Task HandleResetPassword()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        if (resetPasswordModel.NewPassword !=
            resetPasswordModel.ConfirmPassword)
        {
            errorMessage = "Mật khẩu xác nhận không khớp.";
            isLoading = false;
            return;
        }

        try
        {
            var request = new ResetPasswordRequest
            {
                Email = resetPasswordModel.Email.Trim(),
                Token = resetPasswordModel.Token.Trim(),
                NewPassword = resetPasswordModel.NewPassword
            };

            var result = await AuthApi.ResetPasswordAsync(request);

            if (result.Success)
            {
                successMessage = result.Message;

                resetPasswordModel.Token = string.Empty;
                resetPasswordModel.NewPassword = string.Empty;
                resetPasswordModel.ConfirmPassword = string.Empty;

				await Task.Delay(1000);

				Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Đã xảy ra lỗi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ResetPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập email.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(
            ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập mã xác thực.")]
        public string Token { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [System.ComponentModel.DataAnnotations.MinLength(
            6,
            ErrorMessage = "Mật khẩu phải có ít nhất 6 ký tự.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(
            ErrorMessage = "Vui lòng xác nhận mật khẩu.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}